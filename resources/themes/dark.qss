/* 照片筛选工具 v3.5 — 深色主题 */

QMainWindow, QWidget {
    background-color: #1a1a2e;
    color: #d0d4e0;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
}

/* ── 分组框 ── */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    border: 1px solid #2d3148;
    border-radius: 10px;
    margin-top: 12px;
    padding: 18px 14px 10px 14px;
    background: #1f2138;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #c8cde0;
}

/* ── 按钮 ── */
QPushButton {
    padding: 7px 18px;
    border: 1px solid #353858;
    border-radius: 6px;
    background: #252840;
    color: #d0d4e0;
    font-size: 12px;
}
QPushButton:hover {
    background: #2d3050;
    border-color: #4a5090;
}
QPushButton:pressed {
    background: #1c1f35;
}

/* 主按钮（开始分析） */
QPushButton#startBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6c7ce0, stop:1 #4a5ac0);
    color: white;
    border: none;
    font-weight: bold;
    font-size: 13px;
    padding: 9px 28px;
}
QPushButton#startBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7d8cf0, stop:1 #5b6bd4);
}
QPushButton#startBtn:disabled {
    background: #3a3e58;
    color: #666;
}

/* ── 输入框 ── */
QLineEdit {
    border: 1px solid #353858;
    border-radius: 6px;
    padding: 6px 10px;
    background: #252840;
    color: #d0d4e0;
    font-size: 12px;
}
QLineEdit:focus {
    border-color: #6c7ce0;
}

/* ── 表格 ── */
QTableWidget {
    border: 1px solid #2d3148;
    border-radius: 8px;
    gridline-color: #282c42;
    background: #1f2138;
    alternate-background-color: #232640;
    color: #d0d4e0;
    font-size: 12px;
}
QHeaderView::section {
    background: #232640;
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid #353858;
    font-weight: bold;
    font-size: 12px;
    color: #999;
}
QTableWidget::item {
    padding: 4px 6px;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    border: 1px solid #353858;
    height: 6px;
    background: #2a2d48;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #6c7ce0;
    border: 2px solid #1a1a2e;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #8a97f0;
}
QSlider::sub-page:horizontal {
    background: #4a5090;
    border-radius: 3px;
}

/* ── 进度条 ── */
QProgressBar {
    border: 1px solid #2d3148;
    border-radius: 6px;
    text-align: center;
    background: #232640;
    color: #999;
    font-size: 11px;
    height: 22px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6c7ce0, stop:1 #8a97f0);
    border-radius: 5px;
}

/* ── 复选框 ── */
QCheckBox {
    spacing: 8px;
    color: #d0d4e0;
    font-size: 12px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #4a5090;
    border-radius: 4px;
    background: #252840;
}
QCheckBox::indicator:checked {
    background: #6c7ce0;
    border-color: #6c7ce0;
}

/* ── 下拉框 ── */
QComboBox {
    border: 1px solid #353858;
    border-radius: 6px;
    padding: 4px 10px;
    background: #252840;
    color: #d0d4e0;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #6c7ce0;
}
QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
QComboBox QAbstractItemView {
    background: #252840;
    border: 1px solid #353858;
    color: #d0d4e0;
    selection-background-color: #3a4090;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3d4260;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #555;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── 标签 ── */
QLabel {
    color: #d0d4e0;
}
QLabel#subtitle {
    color: #667;
    font-size: 11px;
}
