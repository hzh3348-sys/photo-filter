/* 照片筛选工具 v3.5 — 浅色主题 */

QMainWindow, QWidget {
    background-color: #f8f9fa;
    color: #2c3e50;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
}

/* ── 分组框 ── */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    border: 1px solid #dce1e6;
    border-radius: 10px;
    margin-top: 12px;
    padding: 18px 14px 10px 14px;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #1a1a2e;
}

/* ── 按钮 ── */
QPushButton {
    padding: 7px 18px;
    border: 1px solid #c8cdd3;
    border-radius: 6px;
    background: #ffffff;
    color: #2c3e50;
    font-size: 12px;
}
QPushButton:hover {
    background: #eef1f4;
    border-color: #a0aab4;
}
QPushButton:pressed {
    background: #dde2e7;
}

/* 主按钮（开始分析） */
QPushButton#startBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5c6bc0, stop:1 #3949ab);
    color: white;
    border: none;
    font-weight: bold;
    font-size: 13px;
    padding: 9px 28px;
}
QPushButton#startBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6f7dd4, stop:1 #4a59c4);
}
QPushButton#startBtn:disabled {
    background: #b0b8d0;
    color: #e0e0e0;
}

/* ── 输入框 ── */
QLineEdit {
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 6px 10px;
    background: #ffffff;
    color: #2c3e50;
    font-size: 12px;
}
QLineEdit:focus {
    border-color: #5c6bc0;
}

/* ── 表格 ── */
QTableWidget {
    border: 1px solid #e0e3e7;
    border-radius: 8px;
    gridline-color: #eef0f2;
    background: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #2c3e50;
    font-size: 12px;
}
QHeaderView::section {
    background: #f0f2f5;
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid #dce1e6;
    font-weight: bold;
    font-size: 12px;
    color: #555;
}
QTableWidget::item {
    padding: 4px 6px;
}

/* ── 滑块 ── */
QSlider::groove:horizontal {
    border: 1px solid #d0d5db;
    height: 6px;
    background: #e8ecf0;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #5c6bc0;
    border: 2px solid white;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #3949ab;
}
QSlider::sub-page:horizontal {
    background: #a5b4e0;
    border-radius: 3px;
}

/* ── 进度条 ── */
QProgressBar {
    border: 1px solid #dce1e6;
    border-radius: 6px;
    text-align: center;
    background: #eef0f4;
    color: #555;
    font-size: 11px;
    height: 22px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5c6bc0, stop:1 #7c8cf0);
    border-radius: 5px;
}

/* ── 复选框 ── */
QCheckBox {
    spacing: 8px;
    color: #2c3e50;
    font-size: 12px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #c8cdd3;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #5c6bc0;
    border-color: #5c6bc0;
}

/* ── 下拉框 ── */
QComboBox {
    border: 1px solid #d0d5db;
    border-radius: 6px;
    padding: 4px 10px;
    background: #ffffff;
    color: #2c3e50;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #5c6bc0;
}
QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8cdd3;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #a0aab4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── 标签 ── */
QLabel {
    color: #2c3e50;
}
QLabel#subtitle {
    color: #8899aa;
    font-size: 11px;
}
