/* ══════════════════════════════════════════════════════════
   照片筛选工具 v5.3 — 深色主题（Harness 开发者工具风格）
   tokens: bg #0b0d12 / panel #12151c / border rgba(255,255,255,.07)
   text #e6e9ef / text2 #8b93a5 / accent #4f9cf9 / 紧凑圆角
   ══════════════════════════════════════════════════════════ */

QMainWindow, QWidget {
    background-color: transparent;
    color: #e6e9ef;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 主窗口背景由 gui/main_window._apply_glass_background 绘制（深色渐变，极淡光斑） */

/* ── 对话框 ─────────────────────────────────────────── */
QDialog {
    background-color: #12151c;
}

/* ── 设置滚动区（v5.3） ─────────────────────────── */
QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}
QWidget#settingsScrollContent {
    background: transparent;
}

/* ── 顶部栏（细边框分隔条） ─────────────────────────── */
QFrame#header {
    background: rgba(17, 20, 27, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel#appTitle {
    font-size: 14px;
    font-weight: 600;
    color: #f0f2f7;
}
QLabel#appVersion {
    font-size: 11px;
    color: #5c6474;
    font-weight: 500;
    padding: 1px 6px;   /* v5.3: 去掉灰色底色/边框，纯文字 */
}

/* ── 卡片（细边框面板，无重阴影） ────────────────────── */
QFrame#card {
    background-color: #12151c;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}
QFrame#card:hover {
    border-color: rgba(79, 156, 249, 0.28);
}
QLabel#cardTitle {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #7c8598;
    text-transform: uppercase;
    background: transparent;
    border: none;
}
QLabel#optName {
    font-size: 13px;
    color: #c9cedb;
    background: transparent;
    border: none;
}
QLabel#hint {
    font-size: 11px;
    color: #6b7284;
    background: transparent;
    border: none;
}
QLabel#hint[state="run"] {
    color: #8fb4ff;
}
QLabel#hint[state="ok"] {
    color: #4ade80;
}
QLabel#hint[state="err"] {
    color: #f87171;
}
QLabel#emptyHint {
    color: #5c6474;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* ── 按钮（紧凑圆角） ────────────────────────────────── */
QPushButton {
    background-color: #1a1e27;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 14px;
    color: #c9cedb;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #212633;
    border-color: rgba(255, 255, 255, 0.14);
}
QPushButton:pressed {
    background-color: #262c3b;
}
QPushButton:disabled {
    color: #4a5160;
    background-color: #151922;
    border-color: rgba(255, 255, 255, 0.04);
}

/* 主按钮（开始分析） */
QPushButton#primaryBtn {
    background: #2f6fed;
    color: #ffffff;
    border: none;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 24px;
    border-radius: 8px;
}
QPushButton#primaryBtn:hover {
    background: #3b7cf5;
}
QPushButton#primaryBtn:pressed {
    background: #2a62d6;
}
QPushButton#primaryBtn:disabled {
    background: #24304a;
    color: #5d6b8a;
}

/* 停止按钮 */
QPushButton#stopBtn {
    background-color: #1a1e27;
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.25);
    font-size: 13px;
    font-weight: 600;
    padding: 9px 20px;
    border-radius: 8px;
}
QPushButton#stopBtn:hover {
    background-color: #2a1f26;
    border-color: rgba(248, 113, 113, 0.4);
}
QPushButton#stopBtn:disabled {
    color: #533f45;
    border-color: rgba(248, 113, 113, 0.1);
    background-color: #151922;
}

/* 幽灵按钮 */
QPushButton#ghostBtn {
    background: transparent;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    color: #8fb4ff;
    font-size: 12px;
    font-weight: 500;
    border-radius: 8px;
    padding: 6px 12px;
}
QPushButton#ghostBtn:hover {
    background: rgba(79, 156, 249, 0.1);
    border-color: #4f9cf9;
}

/* 图标按钮 */
QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: #aab2c4;
}
QPushButton#iconBtn:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #e6e9ef;
}
QPushButton#iconBtn:pressed {
    background-color: rgba(255, 255, 255, 0.11);
}

/* 侧边栏设置按钮（左栏底部） */
QPushButton#sidebarBtn {
    background-color: #1a1e27;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
    color: #aab2c4;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}
QPushButton#sidebarBtn:hover {
    background: rgba(79, 156, 249, 0.12);
    border-color: rgba(79, 156, 249, 0.35);
    color: #8fb4ff;
}
QPushButton#sidebarBtn:pressed {
    background: rgba(79, 156, 249, 0.18);
}

/* ── 输入框 ──────────────────────────────────────────── */
QLineEdit {
    background-color: #171b24;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 7px 11px;
    color: #e6e9ef;
    font-size: 12px;
    selection-background-color: rgba(79, 156, 249, 0.35);
}
QLineEdit:hover {
    border-color: rgba(255, 255, 255, 0.16);
}
QLineEdit:focus {
    border-color: #4f9cf9;
    background-color: #191e28;
}
QLineEdit:disabled {
    background-color: #141821;
    color: #4a5160;
}

/* ── 下拉框（三角由 ChevronComboBox 自绘） ───────────── */
QComboBox {
    background-color: #171b24;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 4px 22px 4px 9px;
    color: #c9cedb;
    font-size: 12px;
}
QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background-color: #1a1f2a;
}
QComboBox:focus {
    border-color: #4f9cf9;
}
QComboBox:on {
    border-color: #4f9cf9;
    background-color: #1a1f2a;
}
QComboBox::drop-down {
    border: none;
    width: 0;
}
QComboBox QFrame {
    background-color: #1a1e27;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
}
QComboBox QAbstractItemView {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: transparent;
    selection-color: #e6e9ef;
    font-size: 12px;
}
QComboBox QAbstractItemView::item {
    padding: 7px 10px;
    border-radius: 7px;
    min-height: 16px;
    color: #c9cedb;
}
QComboBox QAbstractItemView::item:selected {
    background-color: rgba(79, 156, 249, 0.18);
}
QComboBox QAbstractItemView::item:hover {
    background-color: rgba(79, 156, 249, 0.12);
}

/* ── 下拉菜单（ChevronComboBox 自绘控件用 QMenu 弹出，v5.3） ── */
QMenu {
    background-color: #1a1e27;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 12px;
    border-radius: 7px;
    color: #c9cedb;
    font-size: 12px;
}
QMenu::item:selected {
    background-color: rgba(79, 156, 249, 0.18);
}
QMenu::item:disabled {
    color: #4a5160;
}
QComboBox:disabled {
    background-color: #141821;
    color: #4a5160;
}

/* ── 表格 ────────────────────────────────────────────── */
QTableWidget {
    background-color: #10131a;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: rgba(79, 156, 249, 0.16);
    selection-color: #e6e9ef;
    outline: none;
    font-size: 12px;
}
QTableWidget::item {
    padding: 7px 9px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
QTableWidget::item:selected {
    background-color: rgba(79, 156, 249, 0.16);
    color: #e6e9ef;
}
QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}
QHeaderView::section {
    background-color: transparent;
    color: #6b7284;
    font-weight: 600;
    font-size: 11px;
    padding: 9px 9px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QTableCornerButton::section {
    background: transparent;
    border: none;
}
QHeaderView::section:first {
    border-top-left-radius: 12px;
}
QHeaderView::section:last {
    border-top-right-radius: 12px;
}

/* ── 滑块 ────────────────────────────────────────────── */
QSlider {
    min-height: 20px;
}
QSlider::groove:horizontal {
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 1px;
}
QSlider::sub-page:horizontal {
    background: #4f9cf9;
    border-radius: 1px;
}
QSlider::handle:horizontal {
    background: #e6e9ef;
    border: 1px solid #4f9cf9;
    width: 11px;
    height: 11px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #7db4fb;
}
QSlider:disabled::groove {
    background: rgba(255, 255, 255, 0.05);
}
QSlider:disabled::handle {
    border-color: rgba(255, 255, 255, 0.15);
    background: #2a3040;
}

/* ── 进度条 ──────────────────────────────────────────── */
QProgressBar {
    background-color: #171b24;
    border: none;
    border-radius: 7px;
    height: 14px;
    text-align: center;
    color: #8b93a5;
    font-size: 10px;
}
QProgressBar::chunk {
    background: #2f6fed;
    border-radius: 7px;
}

/* ── 复选框 ──────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #c9cedb;
    font-size: 12px;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    background-color: #171b24;
}
QCheckBox::indicator:hover {
    border-color: #4f9cf9;
}
QCheckBox::indicator:checked {
    background-color: #2f6fed;
    border-color: #2f6fed;
}
QCheckBox::indicator:disabled {
    background-color: #141821;
    border-color: rgba(255, 255, 255, 0.06);
}

/* ── 滚动条（细） ────────────────────────────────────── */
QScrollBar:vertical {
    width: 9px;
    background: transparent;
    margin: 1px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.28);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    height: 9px;
    background: transparent;
    margin: 1px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.28);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── 分栏拖拽手柄 ────────────────────────────────────── */
QSplitter::handle {
    background: transparent;
}
QSplitter::handle:hover {
    background: rgba(79, 156, 249, 0.25);
    border-radius: 2px;
}
QSplitter::handle:horizontal {
    width: 5px;
}

/* ── 预览框 ──────────────────────────────────────────── */
QLabel#previewBox {
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background-color: rgba(16, 19, 26, 0.6);
    color: #6b7284;
    font-size: 11px;
    padding: 6px;
}

/* ── 提示 ────────────────────────────────────────────── */
QToolTip {
    background-color: #1e2430;
    color: #e6e9ef;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 5px 9px;
    border-radius: 8px;
    font-size: 12px;
}

/* ── 分组框（设置对话框） ─────────────────────────────── */
QGroupBox {
    background-color: #10131a;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    margin-top: 10px;
    padding: 12px 10px 8px 10px;
    font-weight: 600;
    font-size: 12px;
    color: #8b93a5;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #10131a;
}

/* ── 设置对话框：关于信息区（v5.3） ─────────────────── */
QTextBrowser {
    background-color: #10131a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 8px;
    color: #c9cedb;
    font-size: 12px;
}
QSpinBox, QDoubleSpinBox {
    min-height: 22px;
}

/* ── 欢迎页（v5.3 主题适配） ─────────────────────────── */
QLabel#welcomeTitle { color: #f0f2f7; }
QLabel#welcomeVersion, QLabel#welcomeTip, QCheckBox#welcomeSkip { color: #8b93a5; }
QFrame#welcomeCard {
    background-color: #1a1e27;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
}
QLabel#welcomeCardTitle { color: #e6e9ef; }
QLabel#welcomeCardDesc { color: #8b93a5; }

/* ── 消息框 ──────────────────────────────────────────── */
QMessageBox {
    background-color: #12151c;
}
QMessageBox QLabel {
    color: #e6e9ef;
}

/* ── 数字输入框（设置对话框） ────────────────────────── */
QDoubleSpinBox, QSpinBox {
    background-color: #171b24;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 4px 8px;
    color: #c9cedb;
    font-size: 12px;
}
QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #4f9cf9;
}
